{
  "name": "hayot-tracker-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Hayot Tracker - shaxsiy hayotni boshqarish ilovasi (desktop)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "uz.hayottracker.desktop",
    "productName": "Hayot Tracker",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "compression": "maximum",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "stage/backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "stage/backend/prisma",
        "to": "backend/prisma"
      },
      {
        "from": "../frontend/.next-electron",
        "to": "frontend-dist"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
